@model IEnumerable<ResortTralaleritos.Models.Room>

@{
    ViewData["Title"] = "Buscar y Modificar Habitaciones";
    var filter = ViewBag.CurrentFilter as ResortTralaleritos.Models.RoomFilterDto ?? new ResortTralaleritos.Models.RoomFilterDto();
    var totalPages = ViewBag.TotalPages ?? 1;
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalCount = ViewBag.TotalCount ?? 0;
}

<div class="header">
    <h1>Buscar y Modificar Habitaciones</h1>
    <p>Encuentra y administra las habitaciones del resort</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Panel de Filtros -->
<div class="controls">
    <form method="get" action="@Url.Action("Search", "Rooms")" class="filters">
        <!-- Primera fila de filtros -->
        <div style="display: flex; gap: 15px; margin-bottom: 15px; flex-wrap: wrap;">
            <div>
                <label for="roomNumber" style="display: block; color: #710013; font-weight: 600; margin-bottom: 5px;">Número de Habitación</label>
                <input type="text" id="roomNumber" name="roomNumber" 
                       value="@filter.RoomNumber" placeholder="Ej: 101"
                       style="padding: 8px 12px; border: 2px solid #710013; border-radius: 5px; color: #710013;">
            </div>

            <div>
                <label for="roomType" style="display: block; color: #710013; font-weight: 600; margin-bottom: 5px;">Tipo de Habitación</label>
                <select id="roomType" name="roomType" 
                        style="padding: 8px 12px; border: 2px solid #710013; border-radius: 5px; color: #710013;">
                    <option value="">-- Seleccionar --</option>
                    @if (ViewBag.RoomTypes != null)
                    {
                        @foreach (var rt in ViewBag.RoomTypes)
                        {
                            <option value="@rt.Value" selected="@(filter.RoomType == rt.Value)">@rt.Text</option>
                        }
                    }
                </select>
            </div>

            <div>
                <label for="status" style="display: block; color: #710013; font-weight: 600; margin-bottom: 5px;">Estado</label>
                <select id="status" name="status"
                        style="padding: 8px 12px; border: 2px solid #710013; border-radius: 5px; color: #710013;">
                    <option value="">-- Seleccionar --</option>
                    @if (ViewBag.Statuses != null)
                    {
                        @foreach (var s in ViewBag.Statuses)
                        {
                            <option value="@s" selected="@(filter.Status?.ToString() == s.ToString())">@s</option>
                        }
                    }
                </select>
            </div>
        </div>

        <!-- Segunda fila de filtros -->
        <div style="display: flex; gap: 15px; margin-bottom: 15px; flex-wrap: wrap;">
            <div>
                <label for="minPrice" style="display: block; color: #710013; font-weight: 600; margin-bottom: 5px;">Precio Mínimo</label>
                <input type="number" id="minPrice" name="minPrice" 
                       value="@filter.MinPrice" placeholder="0" step="0.01"
                       style="padding: 8px 12px; border: 2px solid #710013; border-radius: 5px; color: #710013;">
            </div>

            <div>
                <label for="maxPrice" style="display: block; color: #710013; font-weight: 600; margin-bottom: 5px;">Precio Máximo</label>
                <input type="number" id="maxPrice" name="maxPrice" 
                       value="@filter.MaxPrice" placeholder="10000" step="0.01"
                       style="padding: 8px 12px; border: 2px solid #710013; border-radius: 5px; color: #710013;">
            </div>

            <div>
                <label for="minCapacity" style="display: block; color: #710013; font-weight: 600; margin-bottom: 5px;">Capacidad Mínima</label>
                <input type="number" id="minCapacity" name="minCapacity" 
                       value="@filter.MinCapacity" placeholder="1" min="1" max="10"
                       style="padding: 8px 12px; border: 2px solid #710013; border-radius: 5px; color: #710013;">
            </div>

            <div>
                <label for="sortBy" style="display: block; color: #710013; font-weight: 600; margin-bottom: 5px;">Ordenar Por</label>
                <select id="sortBy" name="sortBy"
                        style="padding: 8px 12px; border: 2px solid #710013; border-radius: 5px; color: #710013;">
                    <option value="RoomNumber" selected="@(filter.SortBy == "RoomNumber")">Número</option>
                    <option value="price" selected="@(filter.SortBy == "price")">Precio</option>
                    <option value="capacity" selected="@(filter.SortBy == "capacity")">Capacidad</option>
                </select>
            </div>

            <div>
                <label style="display: block; color: #710013; font-weight: 600; margin-bottom: 5px;">
                    <input type="checkbox" name="sortDescending" value="true" @(filter.SortDescending ? "checked" : "")
                           style="margin-right: 5px;">
                    Descendente
                </label>
            </div>
        </div>

        <!-- Botones -->
        <div style="display: flex; gap: 10px; margin-top: 15px;">
            <button type="submit" class="btn-editar">
                Buscar
            </button>
            <a href="@Url.Action("Search", "Rooms")" class="btn-detalles">
                Limpiar Filtros
            </a>
            <a href="@Url.Action("Create", "Rooms")" class="btn-nuevo">
                Nueva Habitación
            </a>
        </div>
    </form>
</div>

<!-- Resultados -->
<div style="margin-top: 30px;">
    <h5 style="color: #710013; margin-bottom: 15px; font-size: 18px; font-weight: 600;">
        Resultados: <strong>@totalCount</strong> habitación(es) encontrada(s)
    </h5>
    
    @if (Model.Any())
    {
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Número</th>
                        <th>Tipo</th>
                        <th>Precio/Noche</th>
                        <th>Capacidad</th>
                        <th>Camas</th>
                        <th>Estado</th>
                        <th>Disponible</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var room in Model)
                    {
                        <tr>
                            <td><strong>@room.RoomNumber</strong></td>
                            <td>@(room.RoomType?.Name ?? "N/A")</td>
                            <td><strong>$@room.PricePerNight</strong></td>
                            <td>@(room.RoomType?.DefaultCapacity ?? 0)</td>
                            <td>@(room.RoomType?.DefaultBeds ?? 0)</td>
                            <td>
                                <span class="estado @GetStatusClass(room.Status)">
                                    @room.Status
                                </span>
                            </td>
                            <td>
                                @if (room.Status == ResortTralaleritos.Models.RoomStatus.Available)
                                {
                                    <span class="estado activo">Disponible</span>
                                }
                                else
                                {
                                    <span class="estado proximo">@room.Status</span>
                                }
                            </td>
                            <td class="acciones">
                                <a href="@Url.Action("Edit", "Rooms", new { id = room.RoomId })" class="btn-editar">Edit</a>
                                <a href="@Url.Action("Details", "Rooms", new { id = room.RoomId })" class="btn-detalles">Details</a>
                                <a href="@Url.Action("AuditHistory", "Rooms", new { id = room.RoomId })" class="btn-detalles">History</a>
                                <a href="@Url.Action("Delete", "Rooms", new { id = room.RoomId })" class="btn-eliminar">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Paginación -->
        @if (totalPages > 1)
        {
            <div style="margin-top: 20px; text-align: center;">
                @if (currentPage > 1)
                {
                    <a href="@Url.Action("Search", "Rooms", new { pageNumber = currentPage - 1 })" 
                       class="btn-detalles" style="margin-right: 10px;">
                        ← Anterior
                    </a>
                }

                @for (int i = 1; i <= totalPages; i++)
                {
                    <a href="@Url.Action("Search", "Rooms", new { pageNumber = i })" 
                       class="@(i == currentPage ? "btn-editar" : "btn-detalles")" style="margin: 0 2px;">
                        @i
                    </a>
                }

                @if (currentPage < totalPages)
                {
                    <a href="@Url.Action("Search", "Rooms", new { pageNumber = currentPage + 1 })" 
                       class="btn-detalles" style="margin-left: 10px;">
                        Siguiente →
                    </a>
                }
            </div>
        }
    }
    else
    {
        <div style="background-color: #FFFDF7; border: 2px solid #FEC43E; border-radius: 8px; padding: 20px; color: #710013;">
            <p style="margin: 0;">No se encontraron habitaciones con los filtros seleccionados.</p>
        </div>
    }
</div>

@functions {
    private string GetStatusClass(ResortTralaleritos.Models.RoomStatus status)
    {
        return status switch
        {
            ResortTralaleritos.Models.RoomStatus.Available => "activo",
            ResortTralaleritos.Models.RoomStatus.Occupied => "expirado",
            ResortTralaleritos.Models.RoomStatus.Cleaning => "proximo",
            ResortTralaleritos.Models.RoomStatus.Maintenance => "inactivo",
            ResortTralaleritos.Models.RoomStatus.Reserved => "proximo",
            _ => "inactivo"
        };
    }
}
