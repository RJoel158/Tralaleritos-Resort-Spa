    @model IEnumerable<ResortTralaleritos.Models.Room>

@{
    ViewData["Title"] = "Rooms";
}

<div class="header">
    <h1>Rooms</h1>
    <p>Manage all the room inventory</p>
</div>

<div class="controls">
    <div></div>
    <a asp-action="Create" class="btn-nuevo">Create New</a>
</div>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Room Number</th>
                <th>Description</th>
                <th>Price Per Night</th>
                <th>Status</th>
                <th>Registration Date</th>
                <th>Room Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>
                        <strong>@Html.DisplayFor(modelItem => item.RoomNumber)</strong>
                    </td>
                    <td>
                        <span class="descripcion">@Html.DisplayFor(modelItem => item.Description)</span>
                    </td>
                    <td>
                        <strong class="porcentaje">$@Html.DisplayFor(modelItem => item.PricePerNight)</strong>
                    </td>
                    <td>
                        <span class="estado @GetStatusClass(item.Status)">
                            @Html.DisplayFor(modelItem => item.Status)
                        </span>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.RegistrationDate)
                    </td>
                    <td>
                        <strong>@Html.DisplayFor(modelItem => item.RoomType.Name)</strong>
                    </td>
                    <td class="acciones">
                        <a asp-action="Edit" asp-route-id="@item.RoomId" class="btn-editar">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.RoomId" class="btn-detalles">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.RoomId" class="btn-eliminar">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@functions {
    private string GetStatusClass(ResortTralaleritos.Models.RoomStatus status)
    {
        return status switch
        {
            ResortTralaleritos.Models.RoomStatus.Available => "activo",
            ResortTralaleritos.Models.RoomStatus.Occupied => "expirado",
            ResortTralaleritos.Models.RoomStatus.Cleaning => "proximo",
            ResortTralaleritos.Models.RoomStatus.Maintenance => "inactivo",
            ResortTralaleritos.Models.RoomStatus.Reserved => "proximo",
            _ => "inactivo"
        };
    }
}
