@model ProyectoHotel.Models.ViewModels.PaymentRequestViewModel

<div style="max-width:700px; margin:auto; font-family:Arial;">

    <h2>Solicitud de Pago</h2>
    <hr />

    <h4>Código de Solicitud: <strong>@Model.RequestCode</strong></h4>
    <p><strong>Reserva #:</strong> @Model.ReservationId</p>

    <h3>Datos del Huésped</h3>
    <p><strong>Nombre:</strong> @Model.GuestFullName</p>
    <p><strong>Email:</strong> @Model.GuestEmail</p>

    <h3>Detalles de la Estancia</h3>
    <p><strong>Check-In:</strong> @Model.CheckIn.ToShortDateString()</p>
    <p><strong>Check-Out:</strong> @Model.CheckOut.ToShortDateString()</p>

    <h3>Habitaciones</h3>
    <table width="100%" border="1" cellpadding="8" style="border-collapse:collapse;">
        <tr style="background:#f0f0f0;">
            <th>Habitación</th>
            <th>Tipo</th>
            <th>Precio/Noche</th>
            <th>Noches</th>
            <th>Subtotal</th>
        </tr>

        @foreach (var room in Model.RoomDetails)
        {
            <tr>
                <td>@room.RoomNumber</td>
                <td>@room.RoomType</td>
                <td>@room.PricePerNight</td>
                <td>@room.Nights</td>
                <td>@room.Subtotal</td>
            </tr>
        }
    </table>

    <h2 style="text-align:right; margin-top:20px;">
        Total: <strong>@Model.TotalAmount</strong>
    </h2>

    <hr />

    <p>Este documento corresponde a la generación de una solicitud de pago previa al check-out.</p>

</div>
